## ---- 1. アストロサイトだけのUMAP（色分け） ----
n_src <- table(astro$source)
small_first <- names(sort(n_src))               # 少ない方を手前（上）に描く
pA <- DimPlot(astro, group.by = "source", order = small_first,
              cols = src_col, pt.size = 0.3) +
  ggtitle("Astrocytes: Miura et al. vs combined5") +
  theme(legend.position = "bottom")

pB <- DimPlot(astro, group.by = "source", split.by = "source",
              cols = src_col, pt.size = 0.3) + NoLegend()

ggsave(file.path(astro_dir, "E1_astro_UMAP_by_source.png"), pA, width = 7.5, height = 7.5, dpi = 200)
ggsave(file.path(astro_dir, "E2_astro_UMAP_by_source_split.png"), pB, width = 13, height = 6.5, dpi = 200)
print(pA); print(pB)

## ---- 2. 統合UMAP全体の中でアストロサイトを色分け ----
cols_all <- c(src_col, "Other cells" = "grey90")
pC <- DimPlot(merged, group.by = "source_astro", cols = cols_all,
              order = small_first, pt.size = 0.1) +
  ggtitle("Astrocytes in the merged UMAP") +
  theme(legend.position = "bottom")
ggsave(file.path(astro_dir, "E3_merged_UMAP_astro_by_source.png"), pC, width = 8, height = 8, dpi = 200)
print(pC)

## ---- 3. 細胞数をそろえた版 ----
set.seed(1)
n_min <- min(n_src)
cells_eq <- unlist(lapply(split(colnames(astro), astro$source), sample, size = n_min))
pD <- DimPlot(astro, cells = cells_eq, group.by = "source", cols = src_col,
              shuffle = TRUE, pt.size = 0.4) +
  ggtitle(sprintf("Downsampled: %d cells each", n_min)) +
  theme(legend.position = "bottom")
ggsave(file.path(astro_dir, "E4_astro_UMAP_by_source_downsampled.png"), pD, width = 7.5, height = 7.5, dpi = 200)
print(pD)



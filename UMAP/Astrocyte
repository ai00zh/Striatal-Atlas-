get_counts <- function(obj) {
  obj <- UpdateSeuratObject(obj)
  if (!"RNA" %in% Assays(obj)) stop("RNA assay がありません: ", paste(Assays(obj), collapse = ", "))
  DefaultAssay(obj) <- "RNA"
  if (inherits(obj[["RNA"]], "Assay5")) obj <- JoinLayers(obj, assay = "RNA")
  m <- LayerData(obj, assay = "RNA", layer = "counts")
  if (nrow(m) == 0 || ncol(m) == 0) stop("RNA counts が空です（dataしか無いオブジェクト）")
  if (any(m@x %% 1 != 0)) warning("counts に非整数値があります。正規化済みの値かもしれません")
  m
}
clean_meta <- function(md) {
  if ("seurat_clusters" %in% colnames(md)) mdoldclusters<-mdseurat_clusters
  md[, !grepl("^nCount_|^nFeature_|^seurat_clusters$|_snn_res\\.", colnames(md)), drop = FALSE]
}

